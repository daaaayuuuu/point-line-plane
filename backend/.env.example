# Runtime
APP_ENV=development
DATABASE_URL=sqlite:///./data/product_factory.db
AUTO_CREATE_DB=false
SQLITE_LOCK_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001

# Authentication. Each invite code is a single-user credential and can be claimed once.
# Duplicate codes are rejected; replace both known placeholders before production.
SESSION_COOKIE_NAME=product_factory_session
SESSION_TTL_HOURS=72
SESSION_SECRET=replace-with-a-long-random-secret
INVITE_CODES=replace-with-local-invite-code

# AI provider. mock never calls an external service.
AI_PROVIDER=mock
AI_MODEL=mock-text-agent-v1
AI_BASE_URL=https://api.example.invalid/v1
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_ATTEMPTS=2
# Keep false until a real-Key end-to-end smoke has been completed and recorded.
AI_PROVIDER_VERIFIED=false

# Controlled artifacts
WORKSPACE_ROOT=./data/workspaces
PREVIEW_TTL_HOURS=72
MAX_UPLOAD_BYTES=10485760
TASK_MAX_ATTEMPTS=2
# Test-only failure injection; keep false outside automated failure-path tests.
TASK_FORCE_FAILURE=false

# Phase 4 controlled code bundle budgets.
CODING_MAX_FILES=24
CODING_MAX_FILE_BYTES=100000
CODING_MAX_TOTAL_BYTES=500000

# Generated code execution. trusted_mock only executes deterministic mock-provider bundles.
# Real-model bundles require the external sandbox adapter and are rejected locally.
GENERATED_EXECUTION_MODE=trusted_mock
EXTERNAL_EXECUTION_BASE_URL=
QUALITY_COMMAND_TIMEOUT_SECONDS=30
QUALITY_MAX_REPAIRS=2
# Test-only quality failure injection; keep 0 outside automated tests.
QUALITY_FORCE_FAILURES=0
PREVIEW_STARTUP_TIMEOUT_SECONDS=10

# Phase 5 encrypted credential storage. Production requires a URL-safe base64
# value that decodes to exactly 32 random bytes. Development may leave it empty
# and derives a local-only key from SESSION_SECRET.
CREDENTIAL_STORE_ROOT=./data/secrets
CREDENTIAL_MASTER_KEY=

# Quota and cost values are configurable because the PRD leaves commercial
# amounts and provider pricing to product confirmation. 1 unit currently maps
# to 1 platform-paid model token.
FREE_QUOTA_UNITS=5000
AI_INPUT_COST_MICROUSD_PER_MILLION=0
AI_OUTPUT_COST_MICROUSD_PER_MILLION=0
COST_CONFIRMATION_THRESHOLD_MICROUSD=100000

# Phase 6 controlled deployment. mock is an explicit dry run and never creates
# cloud resources or returns a fake public URL. Production must use an audited
# HTTPS adapter and inject its token through the secret manager.
DEPLOYMENT_ENABLED=false
DEPLOYMENT_MODE=mock
DEPLOYMENT_ADAPTER_BASE_URL=
DEPLOYMENT_ADAPTER_TOKEN=
DEPLOYMENT_TIMEOUT_SECONDS=60
DEPLOYMENT_DEFAULT_REGION=cn-beijing

# Phase 7 delivery packages and optional trusted GitHub adapter.
DELIVERY_ROOT=./data/deliveries
DELIVERY_MAX_BYTES=20000000
GITHUB_SYNC_MODE=mock
GITHUB_ADAPTER_BASE_URL=
GITHUB_ADAPTER_TOKEN=

# Phase 8 multi-user operations. Production requires PostgreSQL, an external
# managed backup adapter, and a strong operations token from the secret manager.
OPERATIONS_TOKEN=replace-with-a-strong-operations-token
AUTH_RATE_LIMIT_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
BACKUP_ROOT=./data/backups
BACKUP_MODE=sqlite_local
BACKUP_ADAPTER_BASE_URL=
BACKUP_ADAPTER_TOKEN=
PRODUCTION_POSTGRESQL_REQUIRED=true
